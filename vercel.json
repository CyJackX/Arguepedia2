{
  "version": 2,
  "builds": [
    {
      "src": "dist/ssr/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/dist/ssr/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/ssr/index.js"
    }
  ]
}
